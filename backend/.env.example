# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=AIVet
NODE_ENV=development
PORT=8000
RUN_LOCAL=1
FRONTEND_URL=http://localhost:3000

# ── Database (MongoDB Atlas) ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/aivet

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
MAGIC_LINK_EXPIRES_IN=15m

# ── AI Engines ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ── DataForSEO (Google AI Overviews) ───────────────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AIVet <no-reply@aivet.io>"

# ── QStash ─────────────────────────────────────────────────────────────────
QSTASH_URL=https://qstash.upstash.io/v2/publish
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Webhooks base URL ──────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://your-domain.vercel.app

# -- Email provider ---------------------------------------------------------
# Pick ONE. Resolution order is Brevo API -> Resend API -> generic SMTP.
# With none set, mail is logged to the console instead of sent.
#
# Brevo: dashboard -> SMTP & API -> API Keys tab. Starts "xkeysib-".
BREVO_API_KEY=
# Resend: dashboard -> API Keys. Starts "re_".
RESEND_API_KEY=
# Generic SMTP (SendGrid, Brevo relay, Mailgun, SES). Port 465 implies TLS;
# any other port uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The address mail is sent FROM. Must be a sender you have verified with the
# provider above, or it is rejected at send time.
MAIL_FROM_ADDRESS=

# -- Abuse controls ---------------------------------------------------------
# Set to 1 only when this process sits behind a proxy whose forwarded headers
# can be trusted. Auto-detected on Vercel; leave blank elsewhere.
TRUST_PROXY=
# "memory" forces per-process rate-limit counters (tests, or no database).
# Default is the shared Mongo-backed store.
RATE_LIMIT_STORE=
# Throwaway-domain blocklist. Comma-separated additions and exceptions, plus
# a kill switch if the list ever rejects a real customer.
EXTRA_DISPOSABLE_DOMAINS=
ALLOWED_EMAIL_DOMAINS=
ALLOW_DISPOSABLE_EMAIL=
